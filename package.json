{
  "name": "npm-packges-monorepo",
  "private": true,
  "description": "Monorepo containing React component libraries and tools",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter react-datekit build",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "test": "pnpm --filter react-datekit test",
    "typecheck": "pnpm --filter react-datekit typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "~5.7.3"
  }
}